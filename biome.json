{
  "files": {
    "includes": [
      "**",
      "!**/package.json",
      "!!**/dist",
      "!**/*.md",
      "!**/*.yml",
      "!**/*.yaml"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  }
}
